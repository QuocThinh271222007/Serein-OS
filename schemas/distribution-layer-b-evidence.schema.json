{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serein-os/schemas/distribution-layer-b-evidence.schema.json",
  "title": "Serein Distribution Layer-B Evidence",
  "description": "Compact, machine-readable evidence a real Layer-B run (fetch/verify/build/inspect/boot) produces, uploaded as a small CI artifact instead of the multi-GB ISO itself (S7.0R Corrective A/Section 8-9). Never includes a username, hostname, home directory, or token.",
  "type": "object",
  "required": [
    "schema_version",
    "source_commit",
    "base_filename",
    "base_sha256_expected",
    "base_sha256_actual",
    "base_verified",
    "production_iso_filename",
    "production_iso_sha256",
    "production_iso_inspection",
    "qa_boot_iso_filename",
    "qa_boot_iso_sha256",
    "qemu_boot",
    "qemu_boot_mode",
    "boot_marker",
    "target_disk_attached",
    "autoinstall_enabled"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "base_filename": { "type": "string", "minLength": 1 },
    "base_sha256_expected": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "base_sha256_actual": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "base_verified": { "type": "boolean" },
    "production_iso_filename": { "type": "string", "minLength": 1 },
    "production_iso_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "production_iso_inspection": { "type": "string", "enum": ["pass", "fail", "not_performed"] },
    "qa_boot_iso_filename": { "type": ["string", "null"] },
    "qa_boot_iso_sha256": { "type": ["string", "null"] },
    "qemu_boot": { "type": "string", "enum": ["pass", "fail", "not_performed"] },
    "qemu_boot_mode": { "type": ["string", "null"] },
    "boot_marker": { "type": ["string", "null"] },
    "target_disk_attached": { "const": false },
    "autoinstall_enabled": { "const": false }
  }
}
