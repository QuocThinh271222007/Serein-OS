{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serein-os/schemas/cyber-capabilities.schema.json",
  "title": "Serein Cyber Capabilities",
  "description": "Output of `serein cyber capabilities --json` - which cybersecurity stacks Serein can safely provision/manage and whether the underlying tool/mechanism is actually usable, distinct from what is already installed (serein cyber status).",
  "type": "object",
  "required": ["schema_version", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "available", "installed", "usable", "mechanism", "source", "confidence", "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "available": { "type": ["boolean", "null"] },
          "installed": { "type": "boolean" },
          "usable": { "type": ["boolean", "null"] },
          "mechanism": { "type": ["string", "null"] },
          "source": { "type": ["string", "null"] },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
