{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serein-os/schemas/hardware-capabilities.schema.json",
  "title": "Serein Hardware Capabilities",
  "description": "Output of `serein hardware capabilities --json` — what Serein can safely control on this host, distinct from what hardware exists (hardware-report.schema.json).",
  "type": "object",
  "required": ["schema_version", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "available", "mechanism", "confidence", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "available": { "type": ["boolean", "null"] },
          "mechanism": { "type": ["string", "null"] },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
