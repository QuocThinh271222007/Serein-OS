{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serein-os/schemas/focus-plan.schema.json",
  "title": "Serein Focus Plan",
  "description": "Output of `serein focus plan <target> --json` - the canonical FocusPolicy for one focus target (balanced/dev/ai/cyber/private). Planning-only: runtime_enforcement is always false in S6.5.",
  "type": "object",
  "required": [
    "schema_version", "target", "primary_domain", "readiness", "domain_roles",
    "resource_intents", "memory_intent", "gpu_intent", "lifecycle_intents",
    "conflicts", "constraints", "rationale", "runtime_enforcement"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "target": { "type": "string", "enum": ["balanced", "dev", "ai", "cyber", "private"] },
    "primary_domain": { "type": ["string", "null"], "enum": ["dev", "ai", "cyber", "private", null] },
    "readiness": { "type": "string", "enum": ["available", "limited", "blocked", "unknown"] },
    "runtime_enforcement": { "const": false },
    "rationale": { "type": "string", "minLength": 1 },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "domain_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["domain", "state", "readiness", "reason"],
        "additionalProperties": false,
        "properties": {
          "domain": { "type": "string", "enum": ["dev", "ai", "cyber", "private"] },
          "state": { "type": "string", "enum": ["primary", "secondary", "idle", "off"] },
          "readiness": { "type": "string", "enum": ["available", "limited", "blocked", "unknown"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resource_intents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resource", "domain", "priority", "relative_weight", "mechanism",
          "enforceable", "confidence", "reason", "constraints"
        ],
        "additionalProperties": false,
        "properties": {
          "resource": { "type": "string", "enum": ["cpu", "io"] },
          "domain": { "type": "string", "enum": ["dev", "ai", "cyber", "private"] },
          "priority": { "type": "string", "enum": ["primary", "secondary", "idle", "off"] },
          "relative_weight": { "type": ["integer", "null"] },
          "mechanism": { "type": ["string", "null"] },
          "enforceable": { "const": false },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "reason": { "type": "string", "minLength": 1 },
          "constraints": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "memory_intent": {
      "type": "object",
      "required": [
        "system_reserve", "primary_target", "secondary_target", "reclaim_candidates",
        "pressure_policy", "confidence", "target_bytes", "mechanism", "enforceable"
      ],
      "additionalProperties": false,
      "properties": {
        "system_reserve": { "type": "string", "minLength": 1 },
        "primary_target": { "type": "string", "enum": ["high", "medium", "low", "none"] },
        "secondary_target": { "type": "string", "enum": ["high", "medium", "low", "none"] },
        "reclaim_candidates": { "type": "array", "items": { "type": "string" } },
        "pressure_policy": { "type": "string", "minLength": 1 },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "target_bytes": { "type": ["integer", "null"] },
        "mechanism": { "type": "string", "minLength": 1 },
        "enforceable": { "const": false }
      }
    },
    "gpu_intent": {
      "type": "object",
      "required": [
        "preferred_domain", "mode", "release_candidates", "conflicting_domains",
        "enforceable", "mechanism", "confidence", "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "preferred_domain": { "type": ["string", "null"], "enum": ["dev", "ai", "cyber", "private", null] },
        "mode": { "type": "string", "enum": ["preferred", "shared", "release_requested", "unavailable", "unknown"] },
        "release_candidates": { "type": "array", "items": { "type": "string" } },
        "conflicting_domains": { "type": "array", "items": { "type": "string" } },
        "enforceable": { "const": false },
        "mechanism": { "type": ["string", "null"] },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "reason": { "type": "string" }
      }
    },
    "lifecycle_intents": {
      "type": "array",
      "items": { "$ref": "#/$defs/lifecycleIntent" }
    },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/conflict" }
    }
  },
  "$defs": {
    "lifecycleIntent": {
      "type": "object",
      "required": [
        "kind", "target", "domain", "current_state", "target_intent",
        "managed_by_serein", "reversible", "cost", "reason", "status"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["service", "container", "vm"] },
        "target": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "enum": ["dev", "ai", "cyber", "private"] },
        "current_state": { "type": "string", "minLength": 1 },
        "target_intent": {
          "type": "string",
          "enum": ["KEEP", "QUIESCE_CANDIDATE", "PRIORITY_CANDIDATE", "RESOURCE_INCREASE_CANDIDATE", "RESOURCE_REDUCE_CANDIDATE"]
        },
        "managed_by_serein": { "type": "boolean" },
        "reversible": { "type": ["boolean", "null"] },
        "cost": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
        "reason": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["APPLY", "NOOP", "SKIP", "BLOCKED"] }
      }
    },
    "conflict": {
      "type": "object",
      "required": ["resource", "domains", "severity", "resolution", "automatic", "reason"],
      "additionalProperties": false,
      "properties": {
        "resource": { "type": "string", "minLength": 1 },
        "domains": { "type": "array", "items": { "type": "string" } },
        "severity": { "type": "string", "enum": ["low", "medium", "high"] },
        "resolution": { "type": "string", "minLength": 1 },
        "automatic": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
